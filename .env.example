# Database
# Local development: use the file URL below (no TURSO_AUTH_TOKEN needed)
DATABASE_URL=file:./prisma/dev.db

# Turso (production / Vercel deployment)
# DATABASE_URL=libsql://<your-db-name>-<your-org>.turso.io
# TURSO_AUTH_TOKEN=<token from: turso db tokens create teamup>

# NextAuth — required for JWT sessions to work
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
NEXTAUTH_URL=http://localhost:3000
# On Vercel set NEXTAUTH_URL to your deployment URL, e.g.:
# NEXTAUTH_URL=https://teamup-xxx.vercel.app
