generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String
  role      String   @default("TALENT") // TALENT | ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Personal / contact
  phone            String?
  alternativePhone String?
  telegram         String?
  birthdate        DateTime?
  address          String?
  zip              String?
  city             String?
  region           String?
  avatar           String?
  photo            String?
  bio              String?

  // Work / placement
  position          String?
  department        String?
  office            String?
  availability      String?
  shiftWithOtherJob String?
  status            String    @default("ACTIVE") // ACTIVE | INACTIVE | ON_LEAVE | RESIGNED
  startDate         DateTime?
  datePaired        DateTime?
  tuOnboardingDate  DateTime?

  // TeamUp identity
  larkId        String?
  cohort        String?
  trainingClass String?
  discProfile   String?
  axcAcademy    String?

  // Relations
  courseProgress    CourseProgress[]
  lifecycleEvents   LifecycleEvent[]
  adminTasks        AdminTask[]           @relation("AssignedTo")
  createdTasks      AdminTask[]           @relation("CreatedBy")
  callouts          Callout[]
  subCourseProgress SubCourseProgress[]
  emergencyContact  TalentEmergencyContact?
  skills            TalentSkill[]
  equipment         TalentEquipment?
  documents         TalentDocument[]
  placements        TalentPlacement[]

  @@map("users")
}

model TalentEmergencyContact {
  id     String @id @default(cuid())
  userId String @unique
  name   String
  phone  String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("talent_emergency_contacts")
}

model TalentSkill {
  id     String  @id @default(cuid())
  userId String
  skill  String
  notes  String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, skill])
  @@map("talent_skills")
}

model TalentEquipment {
  id                String  @id @default(cuid())
  userId            String  @unique
  mainDevice        String?
  mainDeviceSpecs   String?
  backupDevice      String?
  backupDeviceSpecs String?
  isp               String?
  backupPower       String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("talent_equipment")
}

model TalentDocument {
  id        String   @id @default(cuid())
  userId    String
  type      String   // RESUME | PITCH_VIDEO | INTRO_VIDEO | DISC_FILE | INTERVIEW | PRAC_PROD | TESTIMONIAL | OG_RESUME | APPLICATION
  url       String
  label     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("talent_documents")
}

model TalentPlacement {
  id                   String    @id @default(cuid())
  userId               String
  opsNumber            Int       // 1 or 2
  clientOnboardingDate DateTime?
  bauDate              DateTime?
  disengagementDate    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, opsNumber])
  @@map("talent_placements")
}

model Course {
  id          String   @id @default(cuid())
  title       String
  description String?
  category    String?
  duration    Int?
  thumbnail   String?
  contentUrl  String?
  contentBody String?
  isRequired  Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  progress   CourseProgress[]
  subCourses SubCourse[]

  @@map("courses")
}

model CourseProgress {
  id          String    @id @default(cuid())
  userId      String
  courseId    String
  status      String    @default("NOT_STARTED") // NOT_STARTED | IN_PROGRESS | COMPLETED
  startedAt   DateTime?
  completedAt DateTime?
  score       Float?
  notes       String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("course_progress")
}

model SubCourse {
  id          String   @id @default(cuid())
  courseId    String
  title       String
  description String?
  order       Int      @default(0)
  url         String?
  createdAt   DateTime @default(now())

  course   Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress SubCourseProgress[]

  @@map("sub_courses")
}

model SubCourseProgress {
  id          String    @id @default(cuid())
  userId      String
  subCourseId String
  completed   Boolean   @default(false)
  completedAt DateTime?

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subCourse SubCourse @relation(fields: [subCourseId], references: [id], onDelete: Cascade)

  @@unique([userId, subCourseId])
  @@map("sub_course_progress")
}

model Callout {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  reason    String?
  type      String   @default("CALLOUT") // CALLOUT | ABSENT | LATE
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("callouts")
}

model LifecycleEvent {
  id          String   @id @default(cuid())
  userId      String
  type        String
  title       String
  description String?
  date        DateTime
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("lifecycle_events")
}

model AdminTask {
  id          String    @id @default(cuid())
  title       String
  description String?
  status      String    @default("PENDING") // PENDING | IN_PROGRESS | DONE
  priority    String    @default("MEDIUM")  // LOW | MEDIUM | HIGH
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignedToId String?
  createdById  String

  assignedTo User? @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdBy  User  @relation("CreatedBy", fields: [createdById], references: [id])

  @@map("admin_tasks")
}
